{
  "name": "pitaya-deck",
  "version": "0.4.3-beta",
  "description": "Pitaya Deck — telefon jako panel przycisków do komputera",
  "main": "main.js",
  "author": {
    "name": "Pitayas",
    "email": "inbox@rakunek.com"
  },
  "homepage": "https://github.com/Pitayas-Team/Pitayas-Deck",
  "license": "MIT",
  "scripts": {
    "start": "electron --no-sandbox .",
    "dist": "electron-builder --linux AppImage rpm",
    "plugins-index": "node scripts/plugins-index.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@32.3.3": true
  },
  "build": {
    "appId": "com.pitayas.deck",
    "productName": "Pitaya Deck",
    "copyright": "Copyright © 2026 Pitayas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "core/**/*",
      "deck/**/*",
      "plugins/**/*",
      "editor/**/*",
      "client/**/*",
      "shared/**/*",
      "build/icons/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "deck/helpers/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "executableName": "pitaya-deck",
      "icon": "build/icons",
      "category": "Utility",
      "synopsis": "Telefon jako panel przycisków do komputera",
      "maintainer": "Pitayas <inbox@rakunek.com>",
      "vendor": "Pitayas",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "appImage": {
      "artifactName": "PitayaDeck-${version}-${arch}.${ext}"
    },
    "rpm": {
      "packageName": "pitaya-deck",
      "artifactName": "pitaya-deck-${version}.${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/256x256.png",
      "artifactName": "PitayaDeck-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pitaya Deck",
      "artifactName": "PitayaDeck-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "PitayaDeck-${version}-Portable.${ext}"
    }
  }
}
